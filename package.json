{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm build:seed && astro build && node scripts/build-cf-output.mjs",
    "build:seed": "node scripts/build-emdash-seed.mjs && biome format --write seed/seed.json",
    "prepare:d1-import": "pnpm build:seed && python3 scripts/prepare-d1-import.py",
    "verify:site": "node scripts/verify-emdash-site.mjs",
    "preview": "astro preview",
    "deploy": "pnpm build && cf deploy --prebuilt --mode production",
    "versions:upload": "pnpm build && cf workers versions create --prebuilt --mode production",
    "cf-typegen": "cf workers types",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test --ignore-snapshots --grep-invert 'Visual Regression'",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:admin-editor": "playwright test -c playwright.admin.config.ts",
    "test:e2e:prepare": "pnpm build:seed && emdash secrets generate --write .env && emdash seed seed/seed.json --database data.db --on-conflict update && astro build --config astro.test.config.mjs",
    "test:e2e:server": "pnpm test:e2e:prepare && HOST=127.0.0.1 PORT=8787 node ./dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/react": "^7.1.2",
    "@emdash-cms/cloudflare": "^1.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-code": "3.32.2",
    "@tiptap/extension-code-block": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "astro": "^7.4.4",
    "emdash": "^1.4.0",
    "feed": "^6.0.0",
    "katex": "^0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^11.1.9",
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/build-output-utils": "^0.9.7",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cf": "1.0.0-beta.26",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": "biome check --write --no-errors-on-unmatched"
  }
}
