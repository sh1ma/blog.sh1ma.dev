{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm gen && tsc -b && cf build && pnpm build:feed && pnpm build:sitemap && pnpm build:ogp",
    "gen": "pnpm build:content && pnpm build:routes",
    "build:content": "content-collections build",
    "build:routes": "tsr generate",
    "build:feed": "tsx scripts/build-feed.ts",
    "build:sitemap": "tsx scripts/build-sitemap.ts",
    "build:ogp": "tsx scripts/build-ogp.ts",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && cf deploy --prebuilt --mode production",
    "versions:upload": "pnpm build && cf workers versions create --prebuilt --mode production",
    "cf-typegen": "cf workers types",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "pnpm gen && tsc -b --noEmit",
    "test:e2e": "playwright test --ignore-snapshots --grep-invert 'Visual Regression'",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:server": "pnpm build && vite preview --port 8787"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "dayjs": "^1.11.23",
    "dayjs-plugin-utc": "^0.1.2",
    "feed": "^6.0.0",
    "katex": "^0.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-c82c3efb3",
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "^0.15.3",
    "@content-collections/markdown": "^0.1.4",
    "@content-collections/vite": "^0.3.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.14",
    "lint-staged": "^17.6.0",
    "satori": "^0.35.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.4",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": "biome check --write --no-errors-on-unmatched"
  }
}
