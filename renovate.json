{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "schedule:weekends"
  ],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "1 day",
  "reviewers": ["sh1ma"],
  "labels": ["automated", "chore"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Astro / EmDash 関連ツール",
      "matchPackageNames": [
        "astro",
        "/^@astrojs//",
        "emdash",
        "/^@emdash-cms//"
      ],
      "groupName": "astro-emdash"
    },
    {
      "description": "Cloudflare 関連ツール",
      "matchPackageNames": [
        "cf",
        "@cloudflare/build-output-utils",
        "@cloudflare/workers-types"
      ],
      "groupName": "cloudflare"
    },
    {
      "description": "Tailwind CSS",
      "matchPackageNames": ["tailwindcss", "/^@tailwindcss//"],
      "groupName": "tailwind"
    },
    {
      "description": "Markdown 変換系",
      "matchPackageNames": ["/^rehype-/", "/^remark/", "shiki", "feed"],
      "groupName": "markdown"
    },
    {
      "description": "Biome (lint/format)",
      "matchPackageNames": ["@biomejs/biome"],
      "groupName": "biome"
    },
    {
      "description": "Playwright 本体とブラウザバイナリ",
      "matchPackageNames": ["@playwright/test", "playwright"],
      "groupName": "playwright"
    },
    {
      "description": "React 型定義 (実体は pnpm overrides で pin) は auto-merge",
      "matchPackageNames": ["@types/react", "@types/react-dom"],
      "groupName": "react-types",
      "automerge": true,
      "matchUpdateTypes": ["patch", "minor"]
    },
    {
      "description": "TypeScript / Node 型定義は patch/minor 自動マージ",
      "matchPackageNames": ["typescript", "@types/node"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "lockfile maintenance / patch は auto-merge、レビュー人には通知しない",
      "matchUpdateTypes": ["lockFileMaintenance", "patch"],
      "reviewers": [],
      "automerge": true
    },
    {
      "description": "major は必ずレビュー、まとめない",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["automated", "chore", "major-update"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": false,
    "schedule": ["at any time"]
  }
}
