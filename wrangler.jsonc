{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "blog.sh1ma.dev", "custom_domain": true }],
  "vars": { "EMDASH_SITE_URL": "https://blog.sh1ma.dev" },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  "d1_databases": [{ "binding": "DB", "database_name": "blog-emdash" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "blog-emdash-media" }],
  "triggers": { "crons": ["* * * * *"] },
  "env": {
    "staging": {
      "name": "blog-staging",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "vars": { "EMDASH_SITE_URL": "https://blog-staging.sh1ma.workers.dev" },
      "d1_databases": [
        { "binding": "DB", "database_name": "blog-emdash-staging" },
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "blog-emdash-media-staging" },
      ],
      "triggers": { "crons": ["* * * * *"] },
    },
  },
}
