---
import { BlogHeader } from "../components/BlogHeader/BlogHeader"
import { Footer } from "../components/Footer/Footer"
import "../globals.css"
import "katex/dist/katex.min.css"

interface Props {
  title: string
  description: string
  locale: "ja" | "en"
  translationHref?: string
}

const { title, description, locale, translationHref } = Astro.props
const pathname = Astro.url.pathname
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="blog.sh1ma.dev" href={locale === "en" ? "/en/feed" : "/feed"} />
    <link rel="canonical" href={Astro.url.href} />
    <title>{title}</title>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <BlogHeader pathname={pathname} translationHref={translationHref} client:load />
      <div class="flex-1"><slot /></div>
      <Footer pathname={pathname} />
    </div>
  </body>
</html>
