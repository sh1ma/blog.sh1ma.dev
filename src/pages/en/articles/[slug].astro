---
import { decodeSlug } from "emdash"
import ArticleView from "../../../components/ArticleView.astro"
import BlogLayout from "../../../layouts/BlogLayout.astro"
import { getBlogPost } from "../../../lib/blog-posts"
import { getOgImagePath } from "../../../lib/ogp"

const slug = decodeSlug(Astro.params.slug)
const post = slug ? await getBlogPost(slug, "en") : null
if (!post) return Astro.rewrite("/404")
const translation = slug ? await getBlogPost(slug, "ja") : null
const translationHref = translation ? `/articles/${encodeURIComponent(translation.slug)}` : undefined
---
<BlogLayout title={post.title} description={post.description || "Blog article (English)"} locale="en" translationHref={translationHref} ogType="article" ogImage={getOgImagePath(post, "en")}>
  <ArticleView post={post} locale="en" translationHref={translationHref} />
</BlogLayout>
