---
import BlogLayout from "../layouts/BlogLayout.astro"
Astro.response.status = 404
---
<BlogLayout title="404" description="ページが見つかりませんでした" locale="ja">
  <main class="mx-auto w-full max-w-3xl px-4 py-16 text-center">
    <h1 class="text-4xl font-bold text-text-primary">404</h1>
    <p class="mt-4 text-text-muted">ページが見つかりませんでした</p>
  </main>
</BlogLayout>
