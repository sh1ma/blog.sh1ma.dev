---
// 自前の管理画面 (記事一覧・編集・メディア・タグ) の入り口。integration.ts が
// routes.ts の pattern に inject する。中身はクライアントの SPA (app/App.tsx)。
import AdminApp from "./app/App"
import { accessForRole, ROLE_LABELS } from "./permissions"
import { CLASSIC_PARAM, CLASSIC_SHELL_PATH, classicUrl } from "./routes"

export const prerender = false

// 逃げ道: ?classic=1 なら EmDash の元の管理画面 (SPA) を返す
if (Astro.url.searchParams.get(CLASSIC_PARAM) === "1") {
  return Astro.rewrite(CLASSIC_SHELL_PATH)
}

// 共有キャッシュに載せない・検索エンジンに出さない (EmDash の admin.astro と同じ方針)
Astro.response.headers.set("Cache-Control", "private, no-store")
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow")

// EmDash の auth middleware がログイン済みのユーザーを入れている
// (未ログインならこのページに来る前にログインへ redirect される)
const user = Astro.locals.user
const role = typeof user?.role === "number" ? user.role : 0
const access = accessForRole(role)
const me = user
  ? {
      id: user.id,
      name: user.name ?? null,
      email: user.email,
      role,
      roleLabel: ROLE_LABELS[role] ?? String(role),
    }
  : null
---

<!doctype html>
<html lang="ja" data-admin-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>blog.sh1ma.dev 管理画面</title>
    <script is:inline>
      // 画面が出る前にテーマを決める (ちらつき防止)。保存した選択 → OS の設定の順
      ;(() => {
        let theme = "system"
        try {
          const saved = localStorage.getItem("blog-admin-theme")
          if (saved === "light" || saved === "dark") theme = saved
        } catch {}
        const dark =
          theme === "dark" ||
          (theme === "system" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches)
        document.documentElement.dataset.adminTheme = dark ? "dark" : "light"
      })()
    </script>
  </head>
  <body data-admin="notion">
    {
      me && access.canWrite ? (
        <div id="admin-root">
          <AdminApp client:only="react" me={me} access={access} />
        </div>
      ) : (
        <main class="admin-denied">
          <h1>この画面を使う権限がありません</h1>
          <p>
            記事の作成・編集には「寄稿者」以上のロールが必要です。
            {me ? `現在のロール: ${me.roleLabel}` : ""}
          </p>
          <p>
            <a href={classicUrl.dashboard}>EmDash の管理画面を開く</a>
          </p>
        </main>
      )
    }
    <style is:global>
      .admin-denied {
        max-width: 36rem;
        margin: 15vh auto;
        padding: 0 1.5rem;
        font-family:
          -apple-system, BlinkMacSystemFont, "Hiragino Sans",
          "Hiragino Kaku Gothic ProN", system-ui, sans-serif;
        line-height: 1.7;
        color: #37352f;
      }
      .admin-denied h1 {
        font-size: 1.5rem;
      }
      .admin-denied a {
        color: #514fc9;
      }
    </style>
  </body>
</html>
